font pango:DejaVu Sans 10

set $mod Mod4
set $term alacritty
set $lock /usr/bin/swaylock -f -c 000000

floating_modifier $mod normal
default_border pixel 0
default_floating_border pixel 2
hide_edge_borders none
focus_wrapping yes
focus_follows_mouse yes
focus_on_window_activation smart
mouse_warping output
workspace_layout default
workspace_auto_back_and_forth no

client.focused #376388 #0c0f0c #dbdbdb #71983b #376388
client.focused_inactive #c0c0c0 #0c0f0c #dbdbdb #71983b #c0c0c0
client.unfocused #c0c0c0 #0c0f0c #dbdbdb #71983b #c0c0c0
client.urgent #cc5450 #0c0f0c #dbdbdb #71983b #cc5450
client.placeholder #c0c0c0 #0c0f0c #dbdbdb #71983b #c0c0c0
client.background #0c0f0c

for_window [title="^emacs-float$"] floating enable, resize set 900 500, move position center
for_window [title="^emacs-(launcher|capture|clipboard)$"] floating enable, resize set 1000 620, move position center

input type:keyboard {
    xkb_layout dk
    xkb_variant nodeadkeys
    xkb_options ctrl:nocaps
}

output * bg @wallpaper@ fill

bindsym $mod+0 workspace number 10
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Ctrl+h move workspace to output left
bindsym $mod+Ctrl+l move workspace to output right
bindsym $mod+Down focus down
bindsym $mod+Left focus left
bindsym $mod+Return exec $term
bindsym $mod+Right focus right
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Do you want to exit Sway?' -b 'Yes' 'swaymsg exit'
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r reload
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+x exec $lock
bindsym $mod+Shift+Return exec emacsclient -c -n -a "" -F '((minibuffer . t))'

bindsym $mod+Up focus up
bindsym $mod+a focus parent
bindsym $mod+ae split h
bindsym $mod+c exec emacs-launcher '(obp/sway-agenda)'
bindsym $mod+Ctrl+c exec emacs-launcher '(obp/sway-org-capture)'
bindsym $mod+d exec emacs-launcher '(obp/sway-universal-launcher)'
bindsym $mod+e layout toggle split
bindsym $mod+Ctrl+e exec emacsclient -n -e '(thanos/type)'
bindsym $mod+Ctrl+Return exec emacsclient -n -e '(my/new-frame-with-ghostel)'
bindsym $mod+Ctrl+x exec emacs-launcher '(obp/sway-roam-capture)'
bindsym $mod+Ctrl+y exec emacs-launcher '(obp/sway-clipboard-manager)'
bindsym $mod+f fullscreen toggle
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+minus scratchpad show
bindsym $mod+r mode resize
bindsym $mod+s layout stacking
bindsym $mod+space focus mode_toggle
bindsym $mod+v split v
bindsym $mod+w layout tabbed
bindsym --locked XF86AudioLowerVolume exec pulsemixer --change-volume -4
bindsym --locked XF86AudioMute exec pulsemixer --toggle-mute
bindsym --locked XF86AudioRaiseVolume exec pulsemixer --change-volume +4
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 4%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 4%+
bindsym Print exec grim -g "$(slurp)" - | swappy -f -
bindsym Shift+Print exec grim - | swappy -f -

mode "resize" {
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Escape mode default
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Return mode default
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym h resize grow width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize shrink width 10 px or 10 ppt
}

gaps inner 5
gaps outer 5
smart_gaps on

exec swaymsg workspace 1
exec nm-applet --indicator
exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
