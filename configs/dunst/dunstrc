[global]
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 300)
    origin = top-right
    offset = (6, 30)
    notification_limit = 5
    font = MesloLGS NF 8
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    show_indicators = yes
    enable_recursive_icon_lookup = true
    icon_position = left
    max_icon_size = 64
    line_height = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    separator_color = "#585858"
    frame_width = 1
    frame_color = "#83a598"
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1d2021"
    foreground = "#ebdbb2"
    timeout = 5

[urgency_normal]
    background = "#1d2021"
    foreground = "#ebdbb2"
    timeout = 20

[urgency_critical]
    background = "#1d2021"
    foreground = "#ebdbb2"
    timeout = 0
